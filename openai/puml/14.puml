@startuml
left to right direction

actor "User (Analyst)" as UserAnalyst
actor "External Data Source" as ExternalDataSource

rectangle "DataInsight AI System" {

  (Upload Multimodal Data)
  (Search & Query Insights)
  (Ingest External Data)
  (Process Data by Modality)
  (Run AI Analysis Task)
  (View Explainable Results)

  ' Associations
  UserAnalyst --> (Upload Multimodal Data)
  UserAnalyst --> (Search & Query Insights)
  UserAnalyst --> (View Explainable Results)

  ExternalDataSource --> (Ingest External Data)

  ' Include relationships
  (Upload Multimodal Data) .> (Process Data by Modality) : <<include>>
  (Search & Query Insights) .> (Process Data by Modality) : <<include>>
  (Ingest External Data) .> (Process Data by Modality) : <<include>>

  (Process Data by Modality) .> (Run AI Analysis Task) : <<include>>
  (Run AI Analysis Task) .> (View Explainable Results) : <<include>>

}

@enduml