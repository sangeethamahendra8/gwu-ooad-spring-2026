@startuml

left to right direction

actor "User (Fan/Analyst)" as U
actor "FastF1 Data Source" as FF1

rectangle "F1 Insights & Strategy Explorer" {
  usecase "Select Drivers (up to 2)" as UC1
  usecase "Select Season/Race/Session" as UC2
  usecase "View Tyre Stints" as UC3
  usecase "View Lap Time Comparison" as UC4
  usecase "View Position Over Laps" as UC5
}

U --> UC1
U --> UC2
U --> UC3
U --> UC4
U --> UC5

FF1 --> UC3
FF1 --> UC4
FF1 --> UC5

UC3 ..> UC1 : <<include>>
UC3 ..> UC2 : <<include>>
UC4 ..> UC3 : <<include>>
UC4 ..> UC5 : <<include>>
UC5 ..> UC2 : <<include>>

@enduml