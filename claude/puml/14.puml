@startuml

left to right direction

actor "User (Analyst)" as UA
actor "External Data Source" as EDS

rectangle "DataInsight AI System" {
  usecase "Upload Multimodal Data" as UC1
  usecase "Search & Query Insights" as UC2
  usecase "Ingest External Data" as UC3
  usecase "Process Data by Modality" as UC4
  usecase "Run AI Analysis Task" as UC5
  usecase "View Explainable Results" as UC6
}

UA --> UC1
UA --> UC2
UA --> UC6

EDS --> UC3

UC1 ..> UC4 : <<include>>
UC2 ..> UC4 : <<include>>
UC3 ..> UC4 : <<include>>
UC4 ..> UC5 : <<include>>
UC5 ..> UC6 : <<include>>

@enduml