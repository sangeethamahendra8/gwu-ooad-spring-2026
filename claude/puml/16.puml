@startuml

left to right direction

actor "User" as U
actor "Developer / Admin" as DA

rectangle "Traffic Camera Browser" {
  usecase "Register Account" as UC1
  usecase "Watch Live Traffic Camera" as UC2
  usecase "Watch Past Playback (last 72 hours)" as UC3
  usecase "Add Camera to Favorites" as UC4
  usecase "View Browsing History" as UC5
  usecase "Manage Cameras (Add / Remove)" as UC6
}

U --> UC1
U --> UC2
U --> UC3
U --> UC4
U --> UC5

DA --> UC6

@enduml